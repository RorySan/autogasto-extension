{
  "manifest_version": 3,
  "name": "Autogasto",
  "version": "0.4.0",
  "minimum_chrome_version": "111",
  "description": "Types your Autogasto claims into the expenses portal's own expense form as drafts, in the browser you are already signed into. Makes no network request of its own; the only thing it ever reports back is whether the draft saved.",
  "key": "",
  "externally_connectable": {
    "matches": [
      "https://autogasto.app/*",
      "http://localhost/*",
      "http://127.0.0.1/*"
    ]
  },
  "background": { "service_worker": "background.js", "type": "module" },
  "icons": {
    "192": "icons/pwa-192.png",
    "512": "icons/pwa-512.png"
  },
  "permissions": ["scripting"],
  "host_permissions": [
    "__PORTAL_ORIGIN__/*"
  ]
}
